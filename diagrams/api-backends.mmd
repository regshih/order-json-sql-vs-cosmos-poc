%% ONE API CONTRACT, FIVE INTERCHANGEABLE STORAGE BACKENDS.
%%
%% This is what makes the comparison fair: the same FastAPI process, the same
%% routes, the same response bytes. Only STORAGE_BACKEND changes. A contract
%% test asserts all five return an equivalent full order for the same input.
flowchart LR
    CLIENT["Operational caller<br/>~50 reads/sec"]

    subgraph API["SAME REST API - FastAPI, 8 uvicorn workers"]
        R1["GET /orders/{id}<br/>full logical order"]
        R2["GET /orders/{id}/blocks/{block}<br/>partial read"]
        R3["GET /orders (search)"]
        R4["POST /orders (ingest)"]
        SW["STORAGE_BACKEND<br/>one env var selects the repository"]
    end

    CLIENT --> R1
    CLIENT --> R2
    CLIENT --> R3
    CLIENT --> R4
    R1 --> SW
    R2 --> SW
    R3 --> SW
    R4 --> SW

    SW -->|"sql-full-json"| A[("A. Azure SQL<br/>ord.OrderDocuments<br/>ONE ROW nvarchar(max)")]
    SW -->|"sql-full-json-native"| AN[("A'. Azure SQL<br/>ord.OrderDocumentsNative<br/>ONE ROW native json")]
    SW -->|"cosmos-mongo"| B[("B. Cosmos DB for MongoDB<br/>ONE BSON DOCUMENT<br/>16 MB capability")]
    SW -->|"cosmos-nosql"| C[("C. Cosmos DB for NoSQL<br/>~34 ITEMS per order<br/>hierarchical PK")]
    SW -->|"sql-hybrid"| D[("D. Azure SQL<br/>8 tables + JSON blocks<br/>~34 ROWS per order")]
    SW -->|"fabric"| F[("CONTROL: Fabric<br/>SQL analytics endpoint<br/>over mirrored Delta")]

    classDef full fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef dec fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef ctl fill:#f5f5f5,stroke:#9e9e9e,stroke-dasharray:4 3
    class A,AN,B full
    class C,D dec
    class F ctl
