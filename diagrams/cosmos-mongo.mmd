%% SCENARIO B - Azure Cosmos DB for MongoDB (RU), ONE complete order per BSON DOCUMENT.
%%
%% A genuine single-document store for a 1-5 MB order. It works, and it is the
%% fastest design measured at high concurrency. It also carries three governance
%% constraints that no benchmark can offset - shown here, not hidden.
flowchart TB
    SRC["Source order JSON<br/>0.5-5 MB, deeply nested"]
    ING["Ingest<br/>derive projection ONLY<br/><i>no splitting</i>"]
    SRC --> ING

    subgraph DOC["orderdb.orders_full - ONE BSON DOCUMENT PER LOGICAL ORDER"]
        direction TB
        ID["_id = orderId (lowercased GUID)<br/>customerId, orderVersion<br/>_updatedAt"]
        PROJ["_proj { status, primaryState,<br/>orderNumber, counts, summary }<br/>the indexed projection"]
        BODY["<b>the complete extract envelope</b><br/>stored as native BSON<br/>accepted to 15.04 MB"]
    end

    ING --> ID
    ING --> PROJ
    ING --> BODY

    IDXS["Indexes: _id (platform)<br/>customerId, _proj.status<br/>_proj.primaryState, orderVersion<br/><i>nothing inside the payload is indexed</i>"]
    PROJ -.-> IDXS

    READ["GET /orders/{id}<br/>ONE find_one by _id<br/>meta keys stripped, envelope returned"]
    BODY --> READ

    subgraph PROV["PROVISIONING ORDER IS NOT OPTIONAL"]
        direction TB
        P1["1. create account"]
        P2["2. enable EnableMongo16MBDocumentSupport<br/>CLI or portal ONLY - not ARM/Bicep"]
        P3["3. THEN create the collection"]
        P4["The 16 MB limit applies only to<br/>collections created AFTER enablement.<br/>Wrong order = a silent 2 MB ceiling."]
        P1 --> P2 --> P3 --> P4
    end

    subgraph ENC["BSON IS NOT JSON BYTES"]
        E1["MEASURED: BSON is 1.3-1.55%<br/>LARGER than compact JSON here"]
        E2["A document on the 16 MB line as JSON<br/>is OVER the line once encoded"]
        E3["Sizing from source-file size errs<br/>in the dangerous direction"]
    end

    subgraph GOV["THREE CONSTRAINTS NO BENCHMARK CAN OFFSET"]
        direction TB
        G1["1. The 16 MB capability is INCOMPATIBLE<br/>with customer-managed keys, and<br/>CANNOT BE REMOVED once enabled.<br/>This account can never come under CMK."]
        G2["2. No Entra data-plane auth on the<br/>MongoDB RU API. Account key only.<br/>The mitigation (fetch the key with a<br/>managed identity) needs a CONTROL-PLANE<br/>role that can list account keys."]
        G3["3. No native Fabric mirroring for the<br/>MongoDB API - the only design here<br/>that cannot use the same analytics path."]
    end

    subgraph WCOST["WRITE COST TRACKS DOCUMENT SIZE, NOT CHANGE SIZE"]
        W1["Read 4.87 MB = 57.2 RU"]
        W2["Set ONE scalar = 4,767.5 RU"]
        W3["Replace the WHOLE document = 3,457.6 RU"]
        W4["A one-field edit costs MORE than a full<br/>rewrite: $set forces a server-side<br/>read-modify-write. There is no cheap<br/>small edit to a large document."]
        W1 --> W2 --> W3 --> W4
    end

    DOC -.-> PROV
    DOC -.-> ENC
    DOC -.-> GOV
    DOC -.-> WCOST

    classDef payload fill:#e8f5e9,stroke:#2e7d32,stroke-width:3px
    classDef meta fill:#eef4ff,stroke:#3a5f9f
    classDef warn fill:#ffebee,stroke:#c62828,stroke-width:2px
    classDef caution fill:#fff8e1,stroke:#b8860b
    class BODY payload
    class ID,PROJ,IDXS meta
    class G1,G2,G3 warn
    class P1,P2,P3,P4,E1,E2,E3,W1,W2,W3,W4 caution
