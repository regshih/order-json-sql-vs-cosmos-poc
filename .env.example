# =====================================================================
# POC configuration - PLACEHOLDERS ONLY. Never commit a real .env.
# =====================================================================
# All Azure access uses Entra ID (DefaultAzureCredential / managed
# identity). There is deliberately no password or key setting here.

# ---- Which operational backend the API serves from -------------------
# Five storage designs behind one API contract, plus the Fabric control.
#
#   BACKEND                PHYSICAL STORAGE                  API RESPONSE
#   sql-full-json          ONE SQL row, nvarchar(max)        full JSON
#   sql-full-json-native   ONE SQL row, native json type     full JSON
#   cosmos-mongo           ONE BSON document                 full JSON
#   sql-hybrid             relational rows + JSON blocks     reconstructed
#   cosmos-nosql           many documents                    reconstructed
#   fabric                 Delta (control experiment only)   full JSON
#
# "sql" and "cosmos" still resolve to sql-hybrid and cosmos-nosql.
STORAGE_BACKEND=sql-hybrid

# ---- PATH A: Azure SQL Database --------------------------------------
SQL_SERVER=sql-<name>.database.windows.net
SQL_DATABASE=OrderDb
SQL_POOL_SIZE=16

# ---- PATH B: Azure Cosmos DB for NoSQL -------------------------------
COSMOS_ENDPOINT=https://cosmos-<name>.documents.azure.com:443/
COSMOS_DATABASE=orderdb
COSMOS_CONTAINER=orders
# Conservative working budget below the documented 2 MB hard maximum.
COSMOS_ITEM_TARGET_BYTES=1800000
COSMOS_HARD_MAX_BYTES=2097152

# ---- SCENARIO A: Azure SQL, one complete order per row ----------------
# Uses the tables in sql/schema/02_full_json.sql. No extra connection
# settings - it shares SQL_SERVER / SQL_DATABASE above.
# 1 selects ord.OrderDocumentsNative (native json type) instead of
# ord.OrderDocuments (nvarchar(max)). Note the native type CANNOT be
# mirrored to Fabric - see docs/SOURCES.md N.2.
SQL_FULL_JSON_NATIVE=0

# ---- SCENARIO B: Azure Cosmos DB for MongoDB -------------------------
# The ONLY backend here that cannot authenticate with Entra on the data
# plane: the MongoDB RU API supports account keys only (SOURCES.md M.6).
# The connection string is fetched from ARM at startup using
# DefaultAzureCredential and held in memory - never written to disk,
# never logged. The values below are IDENTIFIERS, not secrets.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-<name>
MONGO_ACCOUNT=mongo-<name>
MONGO_DATABASE=orderdb
MONGO_COLLECTION=orders_full
MONGO_POOL_SIZE=32
# RU capture pins the pool to ONE connection, because
# getLastRequestStatistics reports connection-scoped state. Leave at 0 for
# any latency benchmark; set 1 only for isolated RU measurement.
MONGO_CAPTURE_RU=0
# Optional wire compression, e.g. "zstd,snappy". Unset means driver default.
MONGO_COMPRESSORS=

# ---- Raw archive layer ----------------------------------------------
ARCHIVE_BACKEND=local            # local | adls
ARCHIVE_ACCOUNT_NAME=st<name>
ARCHIVE_FILESYSTEM=raw
ARCHIVE_PREFIX=raw
ARCHIVE_COMPRESS=true
ARCHIVE_LOCAL_ROOT=data/archive

# ---- OPTIONAL CONTROL: direct Fabric/Delta serving -------------------
FABRIC_SQL_ENDPOINT=<workspace>-<id>.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=lh_orders_poc
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_LAKEHOUSE_ID=00000000-0000-0000-0000-000000000000

# ---- Telemetry -------------------------------------------------------
LOG_LEVEL=INFO
TELEMETRY_LOG_REQUESTS=false
APPLICATIONINSIGHTS_CONNECTION_STRING=
